# Copy to .env and fill in real values.
# Generate both with:
#   echo "JWT_SECRET_KEY=$(python3 -c 'import secrets; print(secrets.token_urlsafe(64))')"
#   echo "ENCRYPTION_MASTER_KEY=$(python3 -c 'import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())')"

# JWT signing key (REQUIRED in production, >= 32 bytes). A short value or the
# placeholder below is rejected at startup.
JWT_SECRET_KEY=

# Envelope-encryption master key (REQUIRED in production, base64 of 32 bytes).
# MUST be backed up together with data/weekly_report.db — losing it makes all
# stored content permanently unreadable.
ENCRYPTION_MASTER_KEY=

# Comma-separated allowed origins. Unset = allow all (Bearer-token auth only).
# CORS_ORIGINS=https://your-domain.com

# Database
DATABASE_URL=sqlite:///./data/weekly_report.db

# production turns on mandatory secrets and HSTS. Default: development.
# ENV=production
