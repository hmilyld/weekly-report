# JWT Secret Key (REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=your-super-secret-key-change-this

# CORS origins (comma-separated, default: http://localhost:5173,http://localhost:8000)
# CORS_ORIGINS=https://your-domain.com

# Database
DATABASE_URL=sqlite:///./data/weekly_report.db

# Environment (development / production)
# ENV=development
